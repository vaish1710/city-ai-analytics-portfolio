{
  "_note": "FICTIONAL EXAMPLE CHECKLISTS for testing. Not the City of Chesapeake's requirements. Replace with the real list from the city's eBUILD/permit pages before any real use.",
  "documents": {
    "site_plan":            {"label": "Site plan",                  "keywords": ["site plan", "plot plan", "survey"]},
    "floor_plan":           {"label": "Floor plan",                 "keywords": ["floor plan"]},
    "framing_detail":       {"label": "Deck framing detail",        "keywords": ["framing", "joist", "deck detail"]},
    "structural_drawings":  {"label": "Structural drawings",        "keywords": ["structural", "framing"]},
    "owner_authorization":  {"label": "Owner authorization letter", "keywords": ["owner", "authorization", "letter of agency"]},
    "engineer_letter":      {"label": "Engineer's letter",          "keywords": ["engineer", "stamped"]},
    "elevation_certificate":{"label": "Elevation certificate",      "keywords": ["elevation cert", "\\bec\\b"]},
    "contractor_license":   {"label": "Contractor license",         "keywords": ["contractor", "license"]},
    "product_specification":{"label": "Roofing product specification","keywords": ["spec", "shingle", "product"]}
  },
  "permits": {
    "deck": {"label": "Deck",
             "required": ["site_plan", "framing_detail", "owner_authorization"],
             "conditional": [{"field": "height_ft", "op": "gt", "value": 8, "require": "engineer_letter"},
                             {"field": "in_flood_zone", "op": "eq", "value": true, "require": "elevation_certificate"}]},
    "fence": {"label": "Fence",
              "required": ["site_plan", "owner_authorization"], "conditional": []},
    "residential_addition": {"label": "Residential addition",
              "required": ["site_plan", "floor_plan", "structural_drawings", "owner_authorization"],
              "conditional": [{"field": "uses_contractor", "op": "eq", "value": true, "require": "contractor_license"},
                              {"field": "in_flood_zone", "op": "eq", "value": true, "require": "elevation_certificate"}]},
    "roof_replacement": {"label": "Roof replacement",
              "required": ["product_specification", "owner_authorization"],
              "conditional": [{"field": "uses_contractor", "op": "eq", "value": true, "require": "contractor_license"}]}
  }
}
